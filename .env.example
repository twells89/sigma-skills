# Sigma API credentials
# Copy this plain-text file to `.env` and fill in your values.
# Do not save credentials from TextEdit/Word as RTF: shell dotenv loaders
# cannot parse rich-text formatting. `.env` is ignored by this repository.
#
# Preferred interactive auth: leave CLIENT_ID/SECRET blank and sign in once:
#   eval "$(bash sigma-api/scripts/browser-login.sh)"
# Later, get-token.sh uses that keychain session first. For unattended hosts,
# set client credentials below as the fallback.
# BASE_URL depends on your cloud region — see https://help.sigmacomputing.com/reference/get-started-sigma-api#identify-your-api-request-url

SIGMA_BASE_URL=
# auto (default) | browser | client-credentials
SIGMA_AUTH_MODE=auto
# Optional fallback when using browser login:
SIGMA_CLIENT_ID=
SIGMA_CLIENT_SECRET=
